# EDUKRON ATS Environment Variables Configuration

# ChromaDB Settings
CHROMA_COLLECTION_NAME=ats_resume_intelligence

# Calendly Base Scheduling URL
CALENDLY_URL=https://calendly.com/talent-acquisition/technical-interview

# Email Provider: "sandbox", "smtp", "sendgrid", "twilio"
EMAIL_PROVIDER=sandbox

# SMTP Configuration (e.g. Gmail / Outlook / Corporate)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# SendGrid Configuration
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=recruiter@yourdomain.com

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
